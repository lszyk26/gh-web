# ============================================================
# gh.0lt.top —— GitHub 高速浏览器（自用）
#   静态 SPA 本地直出 + api.github.com 只读缓存层
#   token 只存在浏览器 localStorage，服务端不接触、不记录
# ============================================================

# 限流区（http 上下文）：自用够宽松，但防止单机把 5000/h 打穿
limit_req_zone $binary_remote_addr zone=ghapi:10m rate=6r/s;

# API 响应缓存区（只缓存 GET，容量 200MB，闲置 7 天回收）
proxy_cache_path /var/cache/nginx/gh-api
                 levels=1:2
                 keys_zone=gh_api:20m
                 max_size=200m
                 inactive=7d
                 use_temp_path=off;

# 上游：GitHub API
upstream gh_api_upstream {
    server api.github.com:443;
    keepalive 16;
    keepalive_requests 200;
    keepalive_timeout 60s;
}

# ---------- 80：仅用于 ACME 挑战 ----------
server {
    listen 80;
    listen [::]:80;
    server_name gh.0lt.top;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        auth_basic off;
        allow all;
    }
    location / { return 301 https://$host$request_uri; }
}

# ---------- 443：主站 ----------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name gh.0lt.top;

    # 自用，不写访问日志（连 basic auth 用户也不留痕）
    access_log off;

    ssl_certificate     /etc/letsencrypt/live/gh.0lt.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gh.0lt.top/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /opt/gh-web/web;
    index index.html;

    # 静态资源直接吐，不再跑 bundle，不走任何上游
    location ~* \.(js|css|woff2?|svg|png|ico)$ {
        auth_basic "gh-web";
        auth_basic_user_file /etc/nginx/.ghweb.htpasswd;
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA 入口
    location / {
        auth_basic "gh-web";
        auth_basic_user_file /etc/nginx/.ghweb.htpasswd;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    # ---------- GitHub API 缓存层 ----------
    # 前端请求 /api/xxx  ->  这里翻成 https://api.github.com/xxx
    # 只缓存 GET / HEAD；带 Authorization 的响应按 token 分桶
    location /api/ {
        auth_basic "gh-web";
        auth_basic_user_file /etc/nginx/.ghweb.htpasswd;

        # 限流：防止自己手滑把 5000/h 打爆
        limit_req zone=ghapi burst=20 nodelay;

        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass https://gh_api_upstream;

        proxy_ssl_server_name on;
        proxy_ssl_name api.github.com;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host api.github.com;
        proxy_set_header User-Agent "gh-web/1.0";

        # === 缓存策略 ===
        proxy_cache gh_api;
        proxy_cache_methods GET HEAD;
        proxy_cache_key "gh|$http_authorization|$request_method|$uri$is_args$args";
        proxy_cache_valid 200 5m;
        proxy_cache_valid 301 302 1m;
        proxy_cache_valid 404 1m;
        proxy_cache_valid any 30s;
        # 只缓存明确可共享的响应；带 Set-Cookie / private 的不缓存
        proxy_ignore_headers Set-Cookie Vary Expires;
        proxy_no_cache $cookie_session;
        proxy_cache_bypass $arg_nocache;
        proxy_cache_use_stale updating error timeout http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_lock on;
        proxy_cache_lock_age 10s;
        proxy_cache_lock_timeout 10s;
        proxy_cache_revalidate on;

        # 命中情况回给前端（调试用，前端会读它显示缓存状态）
        add_header X-GHW-Cache $upstream_cache_status always;
        add_header Cache-Control "no-store" always;

        # 上游限流/报错原样透传
        proxy_intercept_errors off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering on;
    }
}
