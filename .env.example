# GH·WEB 运行配置（复制为 .env 后修改；.env 已被 .gitignore 忽略）
#
# 访问口令。留空 = 不启用（只建议本机/局域网）。
GHW_PASSWORD=change-me

# 监听
HOST=0.0.0.0
PORT=8787

# API 缓存（秒 / MB）
GHW_CACHE_TTL=300
GHW_CACHE_MAX_MB=128

# 可选：直接由 Node 提供 HTTPS（不设则用 HTTP，公网建议前置 Caddy/nginx）
# GHW_TLS_CERT=/path/fullchain.pem
# GHW_TLS_KEY=/path/privkey.pem
